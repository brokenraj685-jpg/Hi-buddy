rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function loggedIn() {
      return request.auth != null;
    }

    function isBlockedBetween(uidA, uidB) {
      return exists(/databases/$(database)/documents/privateUsers/$(uidA)/blocked/$(uidB))
        || exists(/databases/$(database)/documents/privateUsers/$(uidB)/blocked/$(uidA));
    }

    function allowsNewChats(uid) {
      let privatePath = /databases/$(database)/documents/privateUsers/$(uid);
      return !exists(privatePath)
        || get(privatePath).data.get('preferences', {}).get('privacy', {}).get('allowNewChats', true) == true;
    }

    // Unique phone and username reservations. Only the owner may remove their own reservation during account-creation rollback.
    match /accountClaims/{claimId} {
      allow read: if loggedIn() && resource.data.uid == request.auth.uid;
      allow create: if loggedIn()
        && !exists(/databases/$(database)/documents/accountClaims/$(claimId))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && (
          (claimId.matches('phone_[0-9]{10}') && request.resource.data.type == 'phone')
          || (claimId.matches('username_[a-z0-9_]{3,20}') && request.resource.data.type == 'username')
        );
      allow update: if false;
      allow delete: if loggedIn() && resource.data.uid == request.auth.uid;
    }

    // Public directory contains only the fields intentionally shown on user profiles.
    match /profiles/{uid} {
      allow read: if true;
      allow create: if loggedIn()
        && request.auth.uid == uid
        && request.resource.data.username is string
        && exists(/databases/$(database)/documents/accountClaims/$(('username_' + request.resource.data.username)))
        && get(/databases/$(database)/documents/accountClaims/$(('username_' + request.resource.data.username))).data.uid == request.auth.uid;
      allow update: if loggedIn()
        && request.auth.uid == uid
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    // Private account preferences and per-user block list.
    match /privateUsers/{uid} {
      allow read, write: if loggedIn() && request.auth.uid == uid;

      match /blocked/{blockedUid} {
        allow read, delete: if loggedIn()
          && request.auth.uid == uid
          && blockedUid != uid;
        allow create: if loggedIn()
          && request.auth.uid == uid
          && blockedUid != uid
          && request.resource.data.uid == blockedUid;
        allow update: if false;
      }
    }

    // Status updates: authenticated users can view; owners can publish and delete their own.
    // Expiry is a display rule (24 hours); no automatic document deletion is performed.
    match /statuses/{statusId} {
      allow read: if loggedIn();
      allow create: if loggedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'username', 'text', 'media', 'createdAt', 'expiresAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 700
        && request.resource.data.media is string
        && request.resource.data.media.size() <= 850000
        && request.resource.data.expiresAt is number;
      allow update, delete: if loggedIn() && resource.data.uid == request.auth.uid;

      // A viewer may create/update only their own view record.
      // Only the status owner can read the complete viewers list.
      match /views/{viewerUid} {
        function statusOwner() {
          return loggedIn()
            && get(/databases/$(database)/documents/statuses/$(statusId)).data.uid == request.auth.uid;
        }
        allow get, list: if statusOwner();
        allow create, update: if loggedIn()
          && request.auth.uid == viewerUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','name','username','viewedAt']);
        allow delete: if statusOwner() || (loggedIn() && request.auth.uid == viewerUid);
      }
    }


    // WebRTC call signalling. Only the two participants can read/update a call.
    match /calls/{callId} {
      function isCallMember() {
        return loggedIn()
          && (resource.data.callerUid == request.auth.uid
            || resource.data.calleeUid == request.auth.uid);
      }
      allow get: if isCallMember();
      // Collection queries must constrain callerUid or calleeUid to the signed-in user.
      allow list: if loggedIn()
        && (resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid);
      allow create: if loggedIn()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.chatId is string
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
        && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members.hasAll([request.auth.uid, request.resource.data.calleeUid])
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.keys().hasOnly(['callerUid','calleeUid','chatId','callerName','calleeName','type','status','createdAt']);
      allow update: if isCallMember()
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.type == resource.data.type
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','offer','answer','acceptedAt','endedAt','durationSeconds'])
        && request.resource.data.status in ['ringing','accepted','rejected','missed','ended']
        && (request.auth.uid == resource.data.callerUid
          ? !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answer','acceptedAt'])
          : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['offer']));
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if loggedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
        allow create: if loggedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if loggedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
        allow create: if loggedIn()
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // One-to-one chats.
    match /chats/{chatId} {
      // Permit only chat documents whose members array contains the signed-in UID.
      // The app queries this collection with where("members", "array-contains", request.auth.uid).
      allow get, list: if loggedIn()
        && resource.data.members is list
        && request.auth.uid in resource.data.members;

      allow create: if loggedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.members.hasAny([request.auth.uid])
        && !isBlockedBetween(
          request.auth.uid,
          request.resource.data.members[0] == request.auth.uid
            ? request.resource.data.members[1]
            : request.resource.data.members[0]
        )
        && allowsNewChats(
          request.resource.data.members[0] == request.auth.uid
            ? request.resource.data.members[1]
            : request.resource.data.members[0]
        );

      allow update: if loggedIn()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members == resource.data.members;

      allow delete: if false;

      match /messages/{messageId} {
        function chatMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        function isMember() {
          return loggedIn()
            && chatMembers() is list
            && chatMembers().hasAny([request.auth.uid]);
        }
        function otherMember() {
          return chatMembers()[0] == request.auth.uid
            ? chatMembers()[1]
            : chatMembers()[0];
        }
        allow read: if isMember();
        allow create: if isMember()
          && !isBlockedBetween(request.auth.uid, otherMember())
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }
  }
}